<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify your email</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #eef3f1;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: #1c2b28;
      }
      table { border-collapse: collapse; }
      img { border: 0; display: block; }
      a { text-decoration: none; }

      .preheader {
        display: none;
        max-height: 0;
        overflow: hidden;
        opacity: 0;
      }

      .wrapper {
        width: 100%;
        padding: 40px 16px;
      }

      .card {
        max-width: 480px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 1px 3px rgba(15, 110, 93, 0.08), 0 12px 32px rgba(15, 110, 93, 0.10);
      }

      .brandbar {
        height: 6px;
        background: linear-gradient(90deg, #0f6e5d 0%, #1b8a72 100%);
      }

      .content {
        padding: 36px 36px 32px;
      }

      .brandname {
        font-size: 15px;
        font-weight: 600;
        color: #0f6e5d;
        letter-spacing: 0.2px;
      }

      .lead {
        text-align: center;
        padding-bottom: 8px;
      }

      h1 {
        font-size: 22px;
        line-height: 1.35;
        margin: 30px 0 12px;
        color: #12211d;
        font-weight: 650;
      }

      p {
        font-size: 15px;
        line-height: 1.6;
        margin: 0 0 16px;
        color: #445752;
      }

      .target-email {
        color: #12211d;
        font-weight: 600;
      }

      .otp-box {
        margin: 8px 0 12px;
        background-color: #f2f8f6;
        border: 1px solid #d3e8e1;
        border-radius: 10px;
        padding: 22px 20px;
        text-align: center;
      }

      .otp-code {
        font-size: 32px;
        font-weight: 700;
        letter-spacing: 10px;
        color: #0f6e5d;
        font-family: "SF Mono", Consolas, Menlo, monospace;
      }

      .meta {
        font-size: 13px;
        color: #6b7b77;
        margin: 0 0 20px;
        text-align: center;
      }

      .alert-box {
        margin: 8px 0 4px;
        background-color: #fdf4ec;
        border: 1px solid #f2ddc4;
        border-radius: 10px;
        padding: 16px 18px;
      }

      .alert-box p {
        font-size: 13px;
        color: #8a5a1f;
        margin: 0;
        line-height: 1.6;
      }

      .divider {
        border: none;
        border-top: 1px solid #e7eeec;
        margin: 28px 0 24px;
      }

      .footer {
        padding: 24px 36px 32px;
        text-align: center;
      }

      .footer p {
        font-size: 12px;
        color: #93a19d;
        margin: 0;
      }

      @media (max-width: 520px) {
        .content { padding: 28px 24px 24px; }
        .footer { padding: 20px 24px 28px; }
        .otp-code { font-size: 26px; letter-spacing: 7px; }
      }
    </style>
  </head>
  <body>
    <div class="preheader">Use this code to verify your PH Healthcare email address. It expires in <%= expirationMinutes %> minutes.</div>

    <table role="presentation" width="100%" class="wrapper">
      <tr>
        <td>
          <table role="presentation" class="card" width="100%">
            <tr>
              <td class="brandbar"></td>
            </tr>
            <tr>
              <td class="content">
                <table role="presentation">
                  <tr>
                    <td class="brandname">PH Healthcare</td>
                  </tr>
                </table>

                <table role="presentation" width="100%" class="lead">
                  <tr>
                    <td align="center">
                      <h1>Verify your email</h1>
                      <p>Hi <%= name %>, use the code below to verify <span class="target-email"><%= email %></span>.</p>
                    </td>
                  </tr>
                </table>

                <div class="otp-box">
                  <span class="otp-code"><%= otp %></span>
                </div>
                <p class="meta">This code expires in <%= expirationMinutes %> minutes.</p>

                <div class="alert-box">
                  <p>If you didn't request this, you can safely ignore this email — no changes will be made to your account.</p>
                </div>

                <hr class="divider" />

                <p style="font-size: 13px; color: #6b7b77; margin: 0;">For your security, never share this code with anyone, including PH Healthcare staff.</p>
              </td>
            </tr>
            <tr>
              <td class="footer">
                <p>&copy; PH Healthcare System. All rights reserved.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>